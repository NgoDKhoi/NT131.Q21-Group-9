# Force LF line endings for source code files (critical for Linux/Pi builds)
*.rs    text eol=lf
*.toml  text eol=lf
*.py    text eol=lf
*.js    text eol=lf
*.css   text eol=lf
*.html  text eol=lf
*.md    text eol=lf
*.txt   text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf
*.json  text eol=lf
*.sh    text eol=lf

# Arduino C++ files
*.cpp   text eol=lf
*.h     text eol=lf
*.ino   text eol=lf
