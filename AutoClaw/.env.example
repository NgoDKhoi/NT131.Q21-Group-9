# ══════════════════════════════════════════════════════
#  AutoClaw — Environment Variables Template
#  Copy file này thành `.env` trên thiết bị chạy thực tế (Pi 4, PC, v.v.)
#  Lệnh: cp .env.example .env
# ══════════════════════════════════════════════════════

# Cổng kết nối Serial với Arduino (Pi 4 thường là /dev/ttyACM0, Windows thường là COM3)
SERIAL_PORT=/dev/ttyACM0
BAUD_RATE=9600

# Cấu hình Flask Web Server
FLASK_PORT=5000
SECRET_KEY=zeroclaw_uit_2026

# Camera Index (0 cho camera đầu tiên, -1 nếu muốn dùng Mock camera giả lập trên PC)
CAMERA_INDEX=0

# Ngrok token (Chỉ cần thiết nếu muốn mở cổng HTTPS ra ngoài để dùng giọng nói/remote)
NGROK_AUTHTOKEN=YOUR_NGROK_AUTHTOKEN_HERE

# API Key của Gemini 2.0 (Để chạy chế độ Tự hành AI - /auto ai)
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE

# Cấu hình Telegram Bot để giám sát & điều khiển từ xa
TELEGRAM_BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN_HERE
TELEGRAM_CHAT_ID=YOUR_TELEGRAM_CHAT_ID_HERE
